@{
    ViewData["Title"] = "Dashboard";
}

<div class="app-shell">
    <div class="page-head">
        <div>
            <span class="eyebrow">Administrator</span>
            <h1>Dashboard</h1>
            <p class="page-sub">Manage users and all expense requests from here.</p>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-md-6">
            <a asp-action="Users" class="card-soft d-block h-100 text-decoration-none p-4">
                <div class="d-flex align-items-start gap-3">
                    <span class="stat-icon" style="width:46px;height:46px;border-radius:13px">
                        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13A4 4 0 0 1 16 11"/></svg>
                    </span>
                    <div>
                        <h4 class="mb-1" style="font-size:1.15rem">User Management</h4>
                        <p class="text-muted mb-0" style="font-size:.9rem">Create and edit Employee and Manager accounts and manage their status.</p>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-md-6">
            <a asp-action="AllRequests" class="card-soft d-block h-100 text-decoration-none p-4">
                <div class="d-flex align-items-start gap-3">
                    <span class="stat-icon" style="width:46px;height:46px;border-radius:13px">
                        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M8 13h8M8 17h5"/></svg>
                    </span>
                    <div>
                        <h4 class="mb-1" style="font-size:1.15rem">Expense Requests</h4>
                        <p class="text-muted mb-0" style="font-size:.9rem">View, filter and sort requests across all departments.</p>
                    </div>
                </div>
            </a>
        </div>
    </div>
</div>
