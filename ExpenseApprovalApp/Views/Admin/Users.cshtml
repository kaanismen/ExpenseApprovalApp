@model List<ExpenseApprovalApp.Models.ViewModels.UserListViewModel>

@{
    ViewData["Title"] = "User Management";
    var activeCount = Model.Count(u => u.IsActive);
    var managers = Model.Count(u => u.Role == "Manager");
}

<div class="app-shell">
    <div class="page-head">
        <div>
            <span class="eyebrow">Administrator</span>
            <h1>User Management</h1>
            <p class="page-sub">Create and edit accounts and manage their active status.</p>
        </div>
        <a asp-action="CreateUser" class="btn btn-primary">+ New User</a>
    </div>

    <div class="stat-grid">
        <div class="stat">
            <div class="stat-label"><span class="stat-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg></span>Total Users</div>
            <div class="stat-value">@Model.Count</div>
        </div>
        <div class="stat">
            <div class="stat-label"><span class="stat-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5" stroke-linecap="round" stroke-linejoin="round"/></svg></span>Active</div>
            <div class="stat-value">@activeCount</div>
        </div>
        <div class="stat">
            <div class="stat-label"><span class="stat-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 11h-6"/></svg></span>Managers</div>
            <div class="stat-value">@managers</div>
        </div>
    </div>

    <div class="mb-3" style="max-width:340px">
        <input type="text" id="userSearch" class="form-control" placeholder="Search by name, email or department..." />
    </div>

    <div class="data-card">
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead>
                    <tr>
                        <th>User</th>
                        <th>Email</th>
                        <th>Department</th>
                        <th>Role</th>
                        <th class="text-center">Requests</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody id="usersBody">
                    @foreach (var user in Model)
                    {
                        var ini = ((string.IsNullOrEmpty(user.FirstName) ? "" : user.FirstName.Substring(0, 1))
                                 + (string.IsNullOrEmpty(user.LastName) ? "" : user.LastName.Substring(0, 1))).ToUpper();
                        <tr class="@(user.IsActive ? "" : "text-muted")"
                            data-search="@($"{user.FirstName} {user.LastName} {user.Email} {user.Department}".ToLower())">
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="avatar" style="width:32px;height:32px;font-size:.72rem;@(user.IsActive ? "" : "filter:grayscale(1);opacity:.7")">@(string.IsNullOrEmpty(ini) ? "?" : ini)</span>
                                    <span class="fw-semibold">@user.FirstName @user.LastName</span>
                                </div>
                            </td>
                            <td>@user.Email</td>
                            <td>@user.Department</td>
                            <td><span class="role-pill">@user.Role</span></td>
                            <td class="text-center">@user.RequestCount</td>
                            <td>
                                @if (user.IsActive)
                                {
                                    <span class="status-badge status-approved">Active</span>
                                }
                                else
                                {
                                    <span class="status-badge" style="background:#f1f5f9;color:#64748b">Inactive</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-2">
                                    <a asp-action="EditUser" asp-route-id="@user.Id" class="btn btn-outline-secondary btn-sm">Edit</a>
                                    <form asp-action="ToggleActive" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@user.Id" />
                                        @Html.AntiForgeryToken()
                                        @if (user.IsActive)
                                        {
                                            <button type="submit" class="btn btn-outline-danger btn-sm" onclick="return confirm('Are you sure you want to deactivate this user?');">Deactivate</button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="btn btn-outline-secondary btn-sm">Activate</button>
                                        }
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div id="noUsers" class="text-muted text-center mt-3 d-none">No users match your search.</div>
</div>

@section Scripts {
    <script>
        const search = document.getElementById('userSearch');
        const rows = Array.from(document.querySelectorAll('#usersBody tr'));
        const noUsers = document.getElementById('noUsers');

        search.addEventListener('input', function () {
            const q = this.value.trim().toLowerCase();
            let visible = 0;
            rows.forEach(r => {
                const match = !q || r.dataset.search.includes(q);
                r.style.display = match ? '' : 'none';
                if (match) visible++;
            });
            noUsers.classList.toggle('d-none', visible > 0);
        });
    </script>
}
