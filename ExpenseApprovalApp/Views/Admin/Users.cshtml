@model List<ExpenseApprovalApp.Models.ViewModels.UserListViewModel>

@{
    ViewData["Title"] = "Kullanıcı Yönetimi";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Kullanıcı Yönetimi</h2>
        <a asp-action="CreateUser" class="btn btn-primary">+ Yeni Kullanıcı</a>
    </div>

    <table class="table table-hover">
        <thead>
            <tr>
                <th>Ad Soyad</th>
                <th>Email</th>
                <th>Departman</th>
                <th>Rol</th>
                <th>Talep Sayısı</th>
                <th>Durum</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr class="@(user.IsActive ? "" : "table-secondary")">
                    <td>@user.FirstName @user.LastName</td>
                    <td>@user.Email</td>
                    <td>@user.Department</td>
                    <td>@user.Role</td>
                    <td>@user.RequestCount</td>
                    <td>
                        @if (user.IsActive)
                        {
                            <span class="badge bg-success">Aktif</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Pasif</span>
                        }
                    </td>
                    <td>
                        <a asp-action="EditUser" asp-route-id="@user.Id" class="btn btn-outline-primary btn-sm">Düzenle</a>

                        <form asp-action="ToggleActive" method="post" class="d-inline">
                            <input type="hidden" name="id" value="@user.Id" />
                            @Html.AntiForgeryToken()
                            @if (user.IsActive)
                            {
                                <button type="submit" class="btn btn-outline-secondary btn-sm" onclick="return confirm('Bu kullanıcıyı pasif yapmak istediğinize emin misiniz?');">Pasifleştir</button>
                            }
                            else
                            {
                                <button type="submit" class="btn btn-outline-success btn-sm">Aktifleştir</button>
                            }
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>