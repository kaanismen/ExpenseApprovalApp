@using ExpenseApprovalApp.Models.Enums
@model List<ExpenseApprovalApp.Models.ViewModels.ExpenseRequestListViewModel>

@{
    ViewData["Title"] = "Approval History";
    var approved = Model.Count(r => r.Status == ExpenseStatus.Approved);
    var rejected = Model.Count(r => r.Status == ExpenseStatus.Rejected);
    var revised = Model.Count(r => r.Status == ExpenseStatus.RevisionRequested);
}

<div class="app-shell">
    <div class="page-head">
        <div>
            <span class="eyebrow">Manager</span>
            <h1>Approval History</h1>
            <p class="page-sub">View the requests you have previously decided on.</p>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state">
            <div class="empty-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v6h6"/><path d="M3.5 9a9 9 0 1 1-.5 5"/><path d="M12 7v5l3 2"/></svg>
            </div>
            <h5>No history</h5>
            <p>You haven't acted on any requests yet.</p>
        </div>
    }
    else
    {
        <div class="stat-grid">
            <div class="stat">
                <div class="stat-label"><span class="stat-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5" stroke-linecap="round" stroke-linejoin="round"/></svg></span>Approved</div>
                <div class="stat-value">@approved</div>
            </div>
            <div class="stat">
                <div class="stat-label"><span class="stat-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 6 12 12M18 6 6 18" stroke-linecap="round"/></svg></span>Rejected</div>
                <div class="stat-value">@rejected</div>
            </div>
            <div class="stat">
                <div class="stat-label"><span class="stat-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 3v6h6M3.5 9a9 9 0 1 1-.5 5" stroke-linecap="round" stroke-linejoin="round"/></svg></span>Revision Requested</div>
                <div class="stat-value">@revised</div>
            </div>
        </div>

        @foreach (var request in Model)
        {
            <div class="req-card mb-3">
                <div class="req-head collapse-head" data-bs-toggle="collapse" data-bs-target="#request-@request.Id" aria-expanded="false">
                    <div>
                        <h5 class="req-title">@request.Title</h5>
                        <span class="req-meta">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18" stroke-linecap="round"/></svg>
                            @request.Time.ToString("dd MMM yyyy HH:mm", System.Globalization.CultureInfo.InvariantCulture)
                        </span>
                    </div>
                    <div class="d-flex align-items-center gap-3">
                        <span class="amount">₺@request.Amount.ToString("N2")</span>
                        <partial name="_StatusBadge" model="request.Status" />
                        <svg class="chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m6 9 6 6 6-6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </div>
                </div>

                <div class="collapse" id="request-@request.Id">
                    <div class="card-body pt-0">
                        <div class="items-table mb-3">
                            <table class="table table-sm mb-0">
                                <thead>
                                    <tr>
                                        <th>Name</th>
                                        <th>Description</th>
                                        <th>Category</th>
                                        <th class="text-end">Amount</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in request.Expenses)
                                    {
                                        <tr>
                                            <td>@item.Name</td>
                                            <td class="text-muted">@item.Description</td>
                                            <td><partial name="_CategoryBadge" model="item.Category" /></td>
                                            <td class="text-end amount">₺@item.Amount.ToString("N2")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        @if (!string.IsNullOrEmpty(request.ManagerComment))
                        {
                            <div class="note @(request.Status == ExpenseStatus.RevisionRequested ? "note-info" : "note-danger")">
                                <svg class="note-ico" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" stroke-linecap="round" stroke-linejoin="round"/></svg>
                                <span><strong>Your Note:</strong> @request.ManagerComment</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    }
</div>
