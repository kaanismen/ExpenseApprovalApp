@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="app-shell" style="max-width:640px">
    <div class="card">
        <div class="card-body p-4 p-md-5 text-center">
            <div class="empty-icon mx-auto" style="background:var(--danger-bg);color:var(--danger)">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg>
            </div>
            <h1 class="h4 mb-2">An error occurred</h1>
            <p class="text-muted">An unexpected problem occurred while processing your request.</p>

            @if (Model.ShowRequestId)
            {
                <p class="mb-0"><strong>Request ID:</strong> <code>@Model.RequestId</code></p>
            }
        </div>
    </div>
</div>
