@model ExpenseApprovalApp.Models.ViewModels.ExpenseRequestViewModel

@{
    ViewData["Title"] = "Yeni Harcama Talebi";
}

<div class="container mt-4">
    <h2>Yeni Harcama Talebi</h2>

    <form asp-action="Create" method="post">
        <div class="mb-3">
            <label asp-for="Title" class="form-label">Başlık</label>
            <input asp-for="Title" class="form-control" maxlength="100" id="titleInput" />
            <div class="d-flex justify-content-between">
                <span asp-validation-for="Title" class="text-danger"></span>
                <small class="text-muted" id="titleCounter">0/100</small>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label">Açıklama</label>
            <textarea asp-for="Description" class="form-control" maxlength="500" id="descriptionInput"></textarea>
            <div class="d-flex justify-content-between">
                <span asp-validation-for="Description" class="text-danger"></span>
                <small class="text-muted" id="descriptionCounter">0/500</small>
            </div>
        </div>

        <h4 class="mt-4">Harcama Kalemleri</h4>
        <table class="table" id="itemsTable">
            <thead>
                <tr>
                    <th>Ad</th>
                    <th>Açıklama</th>
                    <th>Tutar</th>
                    <th>Kategori</th>
                    <th></th>
                </tr>
            </thead>
            <tbody id="itemsBody">
            </tbody>
        </table>

        <button type="button" class="btn btn-secondary mb-3" id="addItemBtn">+ Kalem Ekle</button>

        <div>
            <button type="submit" class="btn btn-primary">Talebi Gönder</button>
            <a asp-action="Index" class="btn btn-outline-secondary">İptal</a>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        let itemIndex = 0;

        function setupCounter(inputId, counterId, max) {
            const input = document.getElementById(inputId);
            const counter = document.getElementById(counterId);
            const update = () => counter.textContent = `${input.value.length}/${max}`;
            input.addEventListener('input', update);
            update();
        }

        setupCounter('titleInput', 'titleCounter', 100);
        setupCounter('descriptionInput', 'descriptionCounter', 500);

        document.getElementById('addItemBtn').addEventListener('click', function () {
            const tbody = document.getElementById('itemsBody');
            const row = document.createElement('tr');

            row.innerHTML = `
                <td><input name="Items[${itemIndex}].Name" class="form-control" maxlength="50" /></td>
                <td><input name="Items[${itemIndex}].Description" class="form-control" maxlength="50" /></td>
                <td><input name="Items[${itemIndex}].Amount" type="number" step="any" min="0.01" class="form-control" /></td>
                <td>
                    <select name="Items[${itemIndex}].Category" class="form-select">
                        <option value="0">Travel</option>
                        <option value="1">Food</option>
                        <option value="2">Office</option>
                        <option value="3">Other</option>
                    </select>
                </td>
                <td><button type="button" class="btn btn-danger btn-sm" onclick="this.closest('tr').remove()">Sil</button></td>
            `;

            tbody.appendChild(row);
            itemIndex++;
        });
    </script>
}